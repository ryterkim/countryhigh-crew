<script>
(function(){

  /* ── Header shrink ───────────────────────────────────────── */
  var header = document.getElementById('chHeader');
  var onScroll = function(){
    header.classList.toggle('is-scrolled', (window.scrollY || document.documentElement.scrollTop) > 70);
  };
  window.addEventListener('scroll', onScroll, { passive:true });
  onScroll();

  /* ── Smooth scroll für In-Page-Anchors ───────────────────── */
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var id = a.getAttribute('href');
      if (id === '#' ) return;
      var el = document.querySelector(id);
      if (!el) return;
      e.preventDefault();
      var y = el.getBoundingClientRect().top + (window.scrollY || 0) - 16;
      window.scrollTo({ top:y, behavior:'smooth' });
    });
  });

  /* ── Testimonial-Carousel ────────────────────────────────── */
  var quotes = [
    { q: {{ q1 | json }}, n: {{ qn1 | json }} },
    { q: {{ q2 | json }}, n: {{ qn2 | json }} },
    { q: {{ q3 | json }}, n: {{ qn3 | json }} },
    { q: {{ q4 | json }}, n: {{ qn4 | json }} },
    { q: {{ q5 | json }}, n: {{ qn5 | json }} }
  ];
  var i = 0, timer = null;
  var elQ = document.getElementById('chQuote'),
      elN = document.getElementById('chQuoteName'),
      elDots = document.getElementById('chDots');

  quotes.forEach(function(_, k){
    var b = document.createElement('button');
    b.className = 'ch-dot' + (k === 0 ? ' is-active' : '');
    b.setAttribute('aria-label', 'Zitat ' + (k+1));
    b.addEventListener('click', function(){ go(k, true); });
    elDots.appendChild(b);
  });

  function go(n, stop){
    i = (n + quotes.length) % quotes.length;
    elQ.textContent = quotes[i].q;
    elN.textContent = quotes[i].n;
    elDots.querySelectorAll('.ch-dot').forEach(function(d, k){
      d.classList.toggle('is-active', k === i);
    });
    if (stop && timer){ clearInterval(timer); timer = null; }
  }
  document.getElementById('chPrev').addEventListener('click', function(){ go(i-1, true); });
  document.getElementById('chNext').addEventListener('click', function(){ go(i+1, true); });
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    timer = setInterval(function(){ go(i+1); }, 6500);
  }
})();
</script>

