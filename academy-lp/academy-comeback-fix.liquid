<!-- ══ HEADER ══════════════════════════════════════════════════ -->
<header class="ch-header" id="chHeader">
  <div class="ch-header__inner">
    <a href="#top" class="ch-header__logo">
      <img src="{{ 'logo-danceacademy-black-stacked.png' | asset_url }}" alt="COUNTRY HIGH Dance Academy">
    </a>
    <a href="#top" class="ch-header__star" aria-label="COUNTRY HIGH">
      <img src="{{ 'icon-star-beige-header.png' | asset_url }}" alt="">
    </a>
    {%- if localization.available_languages.size > 1 -%}
    <form method="post" action="/localization" accept-charset="UTF-8" class="ch-header__lang" id="chLangForm">
      <input type="hidden" name="_method" value="put">
      <input type="hidden" name="return_to" value="{{ request.path }}">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18"></path><path d="M12 3c2.6 2.5 4 5.7 4 9s-1.4 6.5-4 9c-2.6-2.5-4-5.7-4-9s1.4-6.5 4-9z"></path></svg>
      <select name="locale_code" aria-label="Sprache" onchange="this.form.submit()">
        {%- for language in localization.available_languages -%}
          <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>{{ language.endonym_name | capitalize }}</option>
        {%- endfor -%}
      </select>
    </form>
    {%- endif -%}
  </div>
</header>

<!-- ══ HERO ════════════════════════════════════════════════════ -->
<section class="ch-hero" id="top">
  {% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2200 | image_tag: class: 'ch-hero__img', alt: 'Tänzerinnen umarmen sich lachend auf der Tanzfläche', loading: 'eager' }}{% else %}<img class="ch-hero__img" src="{{ 'comeback-hug.jpg' | asset_url }}" alt="Tänzerinnen umarmen sich lachend auf der Tanzfläche" loading="eager">{% endif %}
  <div class="ch-hero__scrim"></div>
  <div class="ch-hero__inner">
    <div class="ch-hero__brand">
      <img src="{{ 'icon-star-beige-header.png' | asset_url }}" alt="">
      <span>Country High Dance Academy</span>
    </div>
    <div class="ch-script ch-hero__script">the best is yet to come</div>
    <h1 class="ch-display ch-hero__title">{{ hero_title }}</h1>
    <p class="ch-hero__lead">{{ hero_lead }}</p>
    <div class="ch-hero__actions">
      <a href="#newsletter" class="ch-btn ch-btn--beige ch-btn--lg">{{ cta_first }}</a>
      <a href="#bootcamp" class="ch-link-under">{{ hero_cta2 }}</a>
    </div>
  </div>
</section>

<!-- ══ OFFENES WORT ════════════════════════════════════════════ -->
<section class="ch-letter">
  <div class="ch-letter__grid">
    <div class="ch-letter__col">
      <div class="ch-letter__head">
        <div class="ch-letter__eyebrow">
          <img src="{{ 'icon-star-beige-header.png' | asset_url }}" alt="">
          <span>{{ letter_eyebrow }}</span>
        </div>
        <h2 class="ch-display ch-letter__title">{{ letter_title }}</h2>
      </div>
      <p>{{ letter_p1 }}</p>
      <p>{{ letter_p2 }}</p>
      <p>{{ letter_p3 }}</p>
      <div class="ch-script ch-letter__sign">{{ sign }}</div>
    </div>

    <div class="ch-letter__aside">
      <div class="ch-letter__photo">
        <img src="{{ 'comeback-notes.jpg' | asset_url }}" alt="Choreografie-Notizen entstehen am Schreibtisch">
      </div>
      <div class="ch-note">
        <div class="ch-note__label">{{ note_label }}</div>
        <p>{{ note_text }}</p>
      </div>
      <div class="ch-stat">
        <div class="ch-stat__num">200+</div>
        <div class="ch-stat__txt">{{ stat_txt }}</div>
      </div>
    </div>
  </div>
</section>

<!-- ══ DREI ANDEUTUNGEN ════════════════════════════════════════ -->
<section class="ch-hints" id="neu">
  <div class="ch-hints__head">
    <div class="ch-eyebrow">{{ hints_eyebrow }}</div>
    <h2 class="ch-display ch-hints__title">{{ hints_title }}</h2>
    <p class="ch-hints__lead">{{ hints_lead }}</p>
  </div>
  <div class="ch-hints__grid">
    <div class="ch-hint">
      <div class="ch-hint__label">{{ hint1_label }}</div>
      <p>{{ hint1_p }}</p>
    </div>
    <div class="ch-hint">
      <div class="ch-hint__label">{{ hint2_label }}</div>
      <p>{{ hint2_p }}</p>
    </div>
    <div class="ch-hint">
      <div class="ch-hint__label">{{ hint3_label }}</div>
      <p>{{ hint3_p }}</p>
    </div>
  </div>
  <div class="ch-badge">
    <img src="{{ 'icon-star-beige-header.png' | asset_url }}" alt="">
    <span>{{ badge }}</span>
  </div>
</section>

<!-- ══ NEWSLETTER ══════════════════════════════════════════════ -->
<section class="ch-news" id="newsletter">
  {% if section.settings.newsletter_image %}{{ section.settings.newsletter_image | image_url: width: 2200 | image_tag: class: 'ch-news__img', alt: 'Tänzerin schnürt ihre Schuhe zuhause vor dem Laptop', loading: 'lazy' }}{% else %}<img class="ch-news__img" src="{{ 'comeback-athome.jpg' | asset_url }}" alt="Tänzerin schnürt ihre Schuhe zuhause vor dem Laptop" loading="lazy">{% endif %}
  <div class="ch-news__scrim"></div>
  <div class="ch-news__grid">
    <div class="ch-news__head">
      <div class="ch-eyebrow ch-eyebrow--dark">{{ news_eyebrow }}</div>
      <h2 class="ch-display ch-news__title">{{ news_title }}</h2>
      <p class="ch-news__lead">{{ news_lead }}</p>
      <div class="ch-script ch-news__script">this is where dancers grow.</div>
    </div>
    <div class="ch-news__card">
      <form action="{{ section.settings.mailchimp_action_url }}" method="post" target="_blank" novalidate class="ch-form" autocomplete="on">
          <div class="ch-form__row">
            <input class="ch-field" type="text" name="FNAME" placeholder="{{ f_fname }}" autocomplete="given-name">
            <input class="ch-field" type="text" name="LNAME" placeholder="{{ f_lname }}" autocomplete="family-name">
          </div>
          <input class="ch-field" type="email" name="EMAIL" placeholder="{{ f_email }}" autocomplete="email" required>
          <select class="ch-field" name="{{ section.settings.mailchimp_level_group | default: 'group[384080]' }}" aria-label="{{ f_level_q }}">
            <option value="">{{ f_level_q }}</option>
            <option value="8">{{ f_level_new }}</option>
            <option value="16">Beginner</option>
