</section>

<!-- ══ STIMMEN ═════════════════════════════════════════════════ -->
<section class="ch-quotes">
  <div class="ch-wrap" style="max-width:1100px;">
    <div class="ch-quotes__head">
      <div class="ch-eyebrow ch-eyebrow--dark">Stimmen aus der ersten Saison</div>
      <h2 class="ch-display ch-quotes__title">Darauf bauen wir weiter</h2>
    </div>
    <div class="ch-quotes__stage">
