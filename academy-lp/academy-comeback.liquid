<script>
(function(){

  /* ── Header shrink ───────────────────────────────────────── */
  var header = document.getElementById('chHeader');
  var onScroll = function(){
    header.classList.toggle('is-scrolled', (window.scrollY || document.documentElement.scrollTop) > 70);
  };
  window.addEventListener('scroll', onScroll, { passive:true });
  onScroll();

  /* ── Smooth scroll für In-Page-Anchors ───────────────────── */
  document.querySelectorAll('a[href^="#"]').forEach(function(a){
    a.addEventListener('click', function(e){
      var id = a.getAttribute('href');
      if (id === '#' ) return;
      var el = document.querySelector(id);
      if (!el) return;
      e.preventDefault();
      var y = el.getBoundingClientRect().top + (window.scrollY || 0) - 16;
      window.scrollTo({ top:y, behavior:'smooth' });
    });
  });

  /* ── Testimonial-Carousel ────────────────────────────────── */
  var quotes = [
    { q:"Ich war sofort begeistert, als ich von eurer Academy gelesen habe – so eine Gelegenheit habe ich lange gesucht. Ihr habt etwas Wunderbares aufgebaut.", n:"— Gabriele Klause, Deutschland" },
    { q:"Der Aufbau der Videos ist super. Man muss nicht immer zurückgehen, weil oft genug wiederholt und von Beginn an getanzt wird. Die Abfolge der Videos ist perfekt. Vielen Dank!", n:"— Thekla Luth, Deutschland" },
    { q:"Wir haben Aurélie bei euch an der Country High Dance Academy gelernt und freuen uns riesig, dass wir diese wunderschöne Choreografie schon tanzen und weitergeben können.", n:"— Andreas & Ulrike Gort, Schweiz" },
    { q:"Guten Morgen und ein grosses Kompliment für dieses Angebot!", n:"— Salvatore Avellino, Italien" },
    { q:"Das war eine grossartige Session, vielen Dank!", n:"— Alison Thomson" }
  ];
  var i = 0, timer = null;
  var elQ = document.getElementById('chQuote'),
      elN = document.getElementById('chQuoteName'),
      elDots = document.getElementById('chDots');

  quotes.forEach(function(_, k){
    var b = document.createElement('button');
    b.className = 'ch-dot' + (k === 0 ? ' is-active' : '');
    b.setAttribute('aria-label', 'Zitat ' + (k+1));
    b.addEventListener('click', function(){ go(k, true); });
    elDots.appendChild(b);
  });

  function go(n, stop){
    i = (n + quotes.length) % quotes.length;
    elQ.textContent = quotes[i].q;
    elN.textContent = quotes[i].n;
    elDots.querySelectorAll('.ch-dot').forEach(function(d, k){
      d.classList.toggle('is-active', k === i);
    });
    if (stop && timer){ clearInterval(timer); timer = null; }
  }
  document.getElementById('chPrev').addEventListener('click', function(){ go(i-1, true); });
  document.getElementById('chNext').addEventListener('click', function(){ go(i+1, true); });
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches){
    timer = setInterval(function(){ go(i+1); }, 6500);
  }
})();
</script>

{% schema %}
{
  "name": "Academy Comeback",
  "tag": "section",
  "class": "section-academy-comeback",
  "settings": [
    { "type": "header", "content": "Bilder" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero-Bild", "info": "Fallback: comeback-hug.png aus assets/" },
    { "type": "image_picker", "id": "newsletter_image", "label": "Newsletter-Band Hintergrund", "info": "Fallback: comeback-athome.png" },
    { "type": "image_picker", "id": "cta_image", "label": "Abschluss-CTA Hintergrund", "info": "Fallback: comeback-overhead-floor.png" },

    { "type": "header", "content": "Neustart" },
    { "type": "text", "id": "relaunch_badge", "label": "Badge-Text", "default": "Neustart Ende 2026" },

    { "type": "header", "content": "Newsletter (Mailchimp)" },
    { "type": "text", "id": "newsletter_cta", "label": "Button-Text", "default": "Dabei sein" },
    { "type": "url", "id": "mailchimp_action_url", "label": "Mailchimp Formular-Action-URL" },
    { "type": "text", "id": "mailchimp_level_group", "label": "Mailchimp Level-Gruppe", "default": "group[384080]" },
    { "type": "text", "id": "mailchimp_gdpr_field", "label": "Mailchimp GDPR-Feld", "default": "gdpr[371654]", "info": "Leer lassen blendet die Zustimmungs-Checkbox aus." },
    { "type": "text", "id": "consent_text", "label": "Zustimmungstext", "default": "Ja, schickt mir Updates zum Start der neuen Academy. Abmeldung jederzeit möglich." },
    { "type": "text", "id": "mailchimp_botfield", "label": "Mailchimp Bot-Feld", "default": "b_56fbb84f707b1db4ba91352ad_5b1bdbe8e9" },

    { "type": "header", "content": "Boot Camp" },
    { "type": "text", "id": "camp_date", "label": "Datum", "default": "20. – 22. November 2026" },
    { "type": "text", "id": "camp_date_note", "label": "Datum-Zusatz", "default": "ein ganzes Wochenende" },
    { "type": "text", "id": "camp_price", "label": "Preis", "default": "CHF 649.–" },
    { "type": "text", "id": "camp_cta", "label": "Button-Text", "default": "Jetzt Platz sichern" },
    { "type": "url", "id": "camp_url", "label": "Button-Link" }
  ],
  "presets": [{ "name": "Academy Comeback" }]
}
{% endschema %}
